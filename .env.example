# Copy to ".env" and fill in your real values (from Lovable → Project → Supabase/Settings).
# Never commit the real .env. VITE_* values are baked into the browser bundle at build time;
# the rest are read by the server at runtime.

# --- Build time (needed when you run `npm run build`) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Runtime (server) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Required for admin actions (create user, suspend, delete). Get it from Supabase → Project → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional ---
# Only needed if you use the cron endpoint.
LOVABLE_CRON_SECRET=
# Only needed for Google Maps place-name SEARCH in the location picker.
# Pasting a Google Maps link already works without these.
GOOGLE_MAPS_API_KEY=
LOVABLE_API_KEY=
